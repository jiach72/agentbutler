# Agent Butler Docker deployment defaults. Copy to .env before starting.

# Select the runtime inventory to inspect: hermes or openclaw.
BUTLER_FRAMEWORK=hermes

# The UI is intentionally bound to loopback by default.
BUTLER_WEB_PORT=7531
BUTLER_WEB_PUBLISH_HOST=127.0.0.1
# 凭据写入仅在本机回环部署且确认没有公网入口时开启。
BUTLER_CREDENTIAL_WRITES_ALLOWED=true
# 记忆写操作开关（归档/恢复/清理/重建索引/加密导出）。默认 false（只读 +
# 写入自检探针）。开启后所有写动作执行前仍会自动备份并记入操作记录。
BUTLER_MEMORY_WRITES_ENABLED=false
# 记忆后端声明：auto（默认，按实例目录标记自动识别 hindsight/mem0）/ hermes /
# hindsight / mem0。显式指定优先于自动检测，用于覆盖检测或强制回默认库。
#BUTLER_MEMORY_BACKEND=auto
# hindsight 记忆探针覆盖项（缺省读 <HERMES_ROOT>/hindsight/config.json 的 api_url）。
# 注意：管家运行在容器内而 hindsight 在宿主机时必须显式指定——容器内 localhost
# 指向容器自身，应改为 http://host.docker.internal:<端口>。hindsight 只监听宿主
# loopback 时，启用 Compose 转发 profile（COMPOSE_PROFILES 含 hindsight-forward，
# 9178 → 宿主 127.0.0.1:9177）并用 http://host.docker.internal:9178。
#BUTLER_HINDSIGHT_BASE_URL=http://host.docker.internal:9178
#BUTLER_HINDSIGHT_TOKEN=
# mem0 记忆探针参数（mem0 Platform REST API；探针会用独立 user_id 写入并删除
# 一条测试记忆）。API Key 未配置时记忆探针降级跳过，不影响其它功能。
#BUTLER_MEM0_BASE_URL=https://api.mem0.ai
#BUTLER_MEM0_API_KEY=
# WSL 原生 Docker 由 Windows 的 127.0.0.1 端口代理转发到 WSL；此时容器需要
# 监听 0.0.0.0 才能接收转发流量。仅当 `netsh interface portproxy show all` 中的
# Windows 监听地址仍为 127.0.0.1（或已启用认证）时，才改为 BUTLER_WEB_PUBLISH_HOST=0.0.0.0。

# 访问口令。面板能重启 AI、改配置、读写记忆，一旦允许本机以外的设备访问就必须设置。
# 留空 = 只允许本机访问（推荐）。设置后：打开面板需要输入口令，Web / updater / Watch 共用。
# 生成方式：openssl rand -base64 32    或    node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
BUTLER_ACCESS_TOKEN=
# updater 独立口令（可选，审计 F-09）：updater 等于主机控制权（git checkout + 重建重启），
# 设置后与面板口令分层、可单独轮换；留空则回退共用 BUTLER_ACCESS_TOKEN。
#BUTLER_UPDATER_ACCESS_TOKEN=
# 内部操作口令（可选，审计 F-06）：未配置 BUTLER_ACCESS_TOKEN 的部署里，保护 gateway
# 的 /api/messages/* 写路径（改通道配置/切接管）；web 代理自动附加。生成方式同上。
#BUTLER_INTERNAL_TOKEN=
# Optional GitHub fine-grained token for higher API limits when installing
# recommended skills. Keep it private and provide only repository read access.
GITHUB_TOKEN=

# AES-256-GCM master key for encrypted LLM credentials. The installer and
# deploy scripts generate this automatically on first run and preserve it on
# later runs. Keep it private; changing it makes existing API Keys undecryptable.
BUTLER_SECRET_MASTER_KEY=
# 把面板发布到 0.0.0.0 却没有口令时，butler-web 会拒绝启动（安全门禁）。
# 确知风险且坚持无口令公开访问时才用：BUTLER_ALLOW_INSECURE_PUBLIC=1
# updater 默认不接触 Docker Socket。需要在容器内自更新并自动重启三个服务时，
# 才显式改为 /var/run/docker.sock；这等同于授予宿主机 Docker 的高权限。
BUTLER_UPDATER_DOCKER_SOCKET=/dev/null

# Persistent volume name. Change only when you intentionally want a new state store.
BUTLER_DATA_VOLUME=agent-butler-data
# 仅在确认没有可用备份且接受风险时设置为 true。
BUTLER_ALLOW_UNBACKED_DEPLOY=false

# Image tag for docker compose builds. Keep the previous value handy for rollback.
BUTLER_VERSION=latest

# Repository URL used by the version page and updater sidecar.
BUTLER_REPOSITORY_URL=https://github.com/jiach72/agentbutler

# Host checkout mounted into updater for in-place self-update. Keep the default
# when starting Compose from the repository root; use an absolute path otherwise.
BUTLER_REPOSITORY_PATH=.

# Internal updater endpoint; normally supplied by docker-compose automatically.
# Override only when running watch against a separately managed updater.
BUTLER_UPDATER_URL=http://butler-updater:7540

# Optional host runtime directories. For WSL Hermes, point this at the Linux-side
# Hermes state directory (for example /home/<user>/.hermes), not /mnt/c. When using
# bash scripts/deploy.sh, the default relative path is automatically replaced by
# $HOME/.hermes when a standard WSL Hermes install is detected.
BUTLER_HERMES_HOST_PATH=./.runtime/hermes
BUTLER_OPENCLAW_HOST_PATH=./.runtime/openclaw

# Docker control is required only for controlling agent containers from the panel.
# Linux: set this to the numeric docker group id. Docker Desktop usually keeps 999.
# 仅在启用下方 socket 时需要。
DOCKER_GID=999
# 仅在需要容器控制能力时取消注释（默认关闭，与 README 安全基线一致）。
# DOCKER_SOCKET_PATH=/var/run/docker.sock

# Optional outbound alert channels. The panel queue works without these values.
# Critical alerts (任务失败、消息链路离线、升级回滚等) are pushed in order:
# Telegram → Bark → Server酱 → SMTP.
BUTLER_TELEGRAM_BOT_TOKEN=
BUTLER_TELEGRAM_CHAT_ID=
# Bark（iOS 推送）：设备 key 必填；自托管服务端可选（默认 https://api.day.app）。
BUTLER_BARK_DEVICE_KEY=
BUTLER_BARK_SERVER=
# Server酱（微信服务号推送）：SendKey 必填。
BUTLER_SERVERCHAN_SENDKEY=
BUTLER_SMTP_HOST=
BUTLER_SMTP_PORT=
BUTLER_SMTP_USER=
BUTLER_SMTP_PASS=
BUTLER_SMTP_FROM=
BUTLER_SMTP_TO=

# Optional runtime probes when the agent runtime runs on the host.
OPENCLAW_GATEWAY_HOST=host.docker.internal
OPENCLAW_GATEWAY_PORT=18789
BUTLER_HERMES_API_HOST=host.docker.internal
BUTLER_HERMES_API_PORT=8642

# Keep the watch scheduler enabled for normal use. Set false for read-only inspection.
BUTLER_AUTO_START=true

# Hermes 消息接入：默认 auto，配置完整时自动接入；设为 false 可显式关闭。
# WSL 原生 Docker 场景请参阅下方 bridge-forward 配置；Bridge 本身保持 loopback，
# 容器通过 host.docker.internal:8755 访问宿主转发器。
BUTLER_ENABLE_HERMES_MESSAGE_RUNTIME=auto
BUTLER_HERMES_BRIDGE_URL=
BUTLER_HERMES_INSTANCE_ID=hermes-main
BUTLER_HERMES_BRIDGE_TOKEN_FILE=/home/butler/hermes/agent-butler/bridge.token
BUTLER_MESSAGE_PROJECTION_DB=/home/butler/data/messages.sqlite
BUTLER_HERMES_BRIDGE_ALLOW_NON_LOOPBACK=false
BUTLER_HERMES_CONTROL_URL=
BUTLER_HERMES_CONTROL_TOKEN_FILE=/home/butler/hermes/agent-butler/control.token


BUTLER_MESSAGE_REQUEST_TIMEOUT_MS=120000
BUTLER_MESSAGE_POLL_INTERVAL_MS=1000
BUTLER_MESSAGE_STOP_TIMEOUT_MS=5000

# —— WSL 原生 Docker 场景（Bridge 强制监听 loopback）——
# 将 BUTLER_HERMES_HOST_PATH 改为真实的 Linux Hermes 目录，并启用 profile：
# COMPOSE_PROFILES=bridge-forward
# BUTLER_HERMES_BRIDGE_URL=http://host.docker.internal:8755
# BUTLER_HERMES_BRIDGE_ALLOW_NON_LOOPBACK=true

# WSL 宿主控制桥：deploy.sh 会自动安装并启用，仅允许 status/start/stop/restart-hermes。
# 容器经 8757 转发到宿主 127.0.0.1:8756，不开放任意终端或 Docker Socket。
# BUTLER_HERMES_CONTROL_URL=http://host.docker.internal:8757

# ───────────────────────── 信任层（Trust Layer，2026-09-11 升级计划）─────────────────────────
# 月度预算（USD）。0 = 未启用；启用后 Watch 每 15 分钟核算一次本月 agent 成本。
# 触线 80% 发提醒，触线 100% 按 BUTLER_BUDGET_ACTION 记录动作并告警。
BUTLER_BUDGET_MONTHLY_USD=0
# 预算触线动作：alert 仅告警（默认）/ downgrade 建议切换降级模型白名单 /
# pause 建议进入全局急停。首版动作均为"建议 + 事件记录"，不自动执行侵入性控制。
BUTLER_BUDGET_ACTION=alert
# 行为审计采集器：解析 Hermes 执行日志生成动作时间线（/audit 页）。
# 只记录结构化动作（文件写入/删除、命令执行、外发、抓取），绝不存储 prompt/对话正文。
BUTLER_AUDIT_ENABLED=true
# 审计数据保留天数（7-90，默认 14）。
BUTLER_AUDIT_RETENTION_DAYS=14
# 审计日志路径（逗号分隔的绝对路径）。缺省自动发现 <Hermes 目录>/logs/*.log。
#BUTLER_AUDIT_LOG_PATHS=/home/butler/hermes/logs/agent.log

# Agent 周报（M2.1）：每周一 08:00 自动生成本周成本/事件/审计/备份汇总并推送到通知渠道。
# 关闭后 /report 页仅可手动生成。
BUTLER_WEEKLY_REPORT_ENABLED=true
# 生成后是否自动推送（dedupeKey=weekly-report:<周一日期>，网关端幂等）。
BUTLER_WEEKLY_REPORT_PUSH=true

# 会话追踪（M2.3）：索引 Hermes 会话元数据 + 动作流，供 /sessions 时间线回放。
# 只索引元数据与结构化动作，绝不采集对话正文。
BUTLER_SESSION_INDEX_ENABLED=true
# 索引保留天数（7-90，默认 30）。
BUTLER_SESSION_INDEX_RETENTION_DAYS=30
# 完整回放（对话正文采集）开关：首版未实现正文采集，开启亦仅索引元数据。
BUTLER_SESSION_REPLAY_ENABLED=false

# 通知即操作（M3.1）：高危动作触发带按钮卡片，可在地铁上直接批准/拒绝。
BUTLER_APPROVAL_ENABLED=true
# 应答时限（秒，60-7200，默认 900=15 分钟）。到期未应答一律按「拒绝」拦截。
BUTLER_APPROVAL_TTL_SEC=900
# 同一动作指纹在该窗口内第 N 次请求时升级为「需 Web 端确认」（默认 3 次 / 24 小时）。
BUTLER_APPROVAL_ESCALATION_THRESHOLD=3
# 是否自动侦测高危动作并开单（关闭后仅响应显式 API 请求）。
BUTLER_APPROVAL_AUTO_DETECT=true
# 审批单保留天数（7-90，默认 30）。
BUTLER_APPROVAL_RETENTION_DAYS=30
# 网关回调 Watch 决策端点的地址（缺省 http://127.0.0.1:7533）。
#BUTLER_WATCH_HTTP_URL=http://127.0.0.1:7533
# Telegram 内联按钮回执校验密钥；设置后 webhook 需带同名 X-Telegram-Bot-Api-Secret-Token。
#BUTLER_TELEGRAM_WEBHOOK_SECRET=
# 面板公网基址：卡片降级链接（微信/邮件/Bark 无内联按钮）指向的地址。
#BUTLER_PUBLIC_BASE_URL=https://butler.example.com

# 升级金丝雀（M3.2）：新版本先在影子环境跑一轮真实任务，三指标全过才切换。
BUTLER_CANARY_ENABLED=true
# 首次运行时的升级策略：aggressive（跳过金丝雀）/ standard（24h 观察窗）/ conservative（48h 观察窗）。
BUTLER_UPGRADE_POLICY=standard

# 假进度检测（M3.3）：把「声称完成」与真实副作用动作对账，杜绝嘴上进度。
BUTLER_PROGRESS_INTEGRITY_ENABLED=true
# 进度声明保留天数（7-90，默认 30）。
BUTLER_PROGRESS_RETENTION_DAYS=30
